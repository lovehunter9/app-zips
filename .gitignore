# JetBrains IDE 每次操作/索引都会改写的个人工作区状态,不入库
.idea/workspace.xml

# macOS
.DS_Store

# Python 缓存
__pycache__/
*.pyc

# Office 临时锁文件 + 由 .md 经 generate_doc.py 生成的产物(源 .md 已入库,不收生成件)
~$*
*.docx
*.pdf

# 音频/基准测试数据(可再生,不入库)
*.wav
*.ics
.audiocheck/

# 打包产物 & 备份(chart 源码目录已入库,.tgz 是可再生的构建产物)
*.tgz
*.tgz.bak*
*.bak
*.full-backup

